# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# WorkBuddy workspace memory
.workbuddy/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# LLM model files (large binaries, downloaded separately)
/assets/models/*.gguf

# Temporary native build artifacts
/native/

# 学习/工作日志与早期快照（本地保留，不随公开仓库分发）
# 例外：docs/notes/2026-09-11/ 是端侧 KV 复用技术评估，被 PROJECT.md 与多份设计文档引用
/docs/notes/*
!/docs/notes/2026-09-11/
/docs/archived/
/docs/plans/archived/
